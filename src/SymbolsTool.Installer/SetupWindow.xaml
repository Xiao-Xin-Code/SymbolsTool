<Window x:Class="SymbolsTool.Installer.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="符号工具 安装程序"
        Width="680" Height="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        Background="#0F0F1A" Foreground="#E4E4E7"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        Icon="pack://application:,,,/AppIcon.ico">

    <Window.Resources>

        <!-- 主按钮 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#6366F1" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4F46E5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4338CA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次按钮 -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E4E4E7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#313244" BorderBrush="#45475A" BorderThickness="1" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3B3B52" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#28283C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题栏关闭按钮 -->
        <Style x:Key="TitleCloseButton" TargetType="Button">
            <Setter Property="Foreground" Value="#A6ADC8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EF4444" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 路径输入框 -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#313244" />
            <Setter Property="Foreground" Value="#E4E4E7" />
            <Setter Property="CaretBrush" Value="#E4E4E7" />
            <Setter Property="SelectionBrush" Value="#6366F1" />
            <Setter Property="BorderBrush" Value="#45475A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#6366F1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 复选框 -->
        <Style x:Key="DarkCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E4E4E7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="5"
                                    Background="#313244" BorderBrush="#45475A" BorderThickness="1.5"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="CheckMark" Text="✓" FontSize="12" FontWeight="Bold"
                                           Foreground="#FFFFFF" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#6366F1" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#6366F1" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#818CF8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 进度条 -->
        <Style x:Key="DarkProgressBar" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="#313244" CornerRadius="4" />
                            <Border x:Name="PART_Indicator" Background="#6366F1" CornerRadius="4"
                                    HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border BorderBrush="#2A2A3E" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="#181825" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="20,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/AppIcon.ico" Width="24" Height="24" />
                        <TextBlock Text="符号工具  安装程序" Margin="10,0,0,0" FontSize="14"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="CloseButton" Content="✕" Width="34" Height="30"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource TitleCloseButton}" Click="Close_Click" />
                </Grid>
            </Border>

            <!-- 内容区 -->
            <Grid Grid.Row="1">

                <!-- 第 1 步：安装选项 -->
                <StackPanel x:Name="OptionsPage" Margin="32,26,32,24">
                    <TextBlock Text="安装符号工具" FontSize="24" FontWeight="Bold" Foreground="#F4F4F7" />
                    <TextBlock Text="选择安装位置。程序、设置与卸载程序都只写入该目录，不在系统其它位置留下文件。"
                               Margin="0,8,0,0" Foreground="#A6ADC8" TextWrapping="Wrap" />

                    <TextBlock Text="安装位置" Margin="0,26,0,8" Foreground="#CDD6F4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="84" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InstallPathBox" Height="38" Style="{StaticResource DarkTextBox}" />
                        <Button Grid.Column="1" Content="浏览…" Margin="10,0,0,0"
                                Style="{StaticResource SecondaryButton}" Click="Browse_Click" />
                    </Grid>

                    <CheckBox x:Name="AutoStartCheck" Content="开机时自动启动符号工具（当前用户）"
                              Margin="0,22,0,0" Style="{StaticResource DarkCheckBox}" />
                    <CheckBox x:Name="LaunchCheck" Content="安装完成后立即启动符号工具" IsChecked="True"
                              Margin="0,12,0,0" Style="{StaticResource DarkCheckBox}" />

                    <Border Background="#1E1E2E" CornerRadius="10" Padding="14,12" Margin="0,24,0,0">
                        <TextBlock x:Name="StatusText" Text="准备就绪" Foreground="#A6ADC8" TextWrapping="Wrap" />
                    </Border>

                    <Grid Margin="0,22,0,0">
                        <TextBlock Text="卸载：在安装目录运行 Uninstall.exe，或在“设置 → 应用”中卸载。"
                                   Foreground="#64748B" FontSize="11.5" TextWrapping="Wrap"
                                   Width="400" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <Button x:Name="InstallButton" Content="安装" Width="120" Height="40"
                                HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}"
                                Click="Install_Click" />
                    </Grid>
                </StackPanel>

                <!-- 第 2 步：安装中 -->
                <StackPanel x:Name="ProgressPage" Margin="32,44,32,24" Visibility="Collapsed">
                    <TextBlock Text="正在安装…" FontSize="22" FontWeight="Bold" />
                    <TextBlock x:Name="ProgressDetail" Margin="0,12,0,0" Height="44"
                               Foreground="#A6ADC8" TextWrapping="Wrap" Text="正在准备…" />
                    <ProgressBar x:Name="InstallProgress" Height="8" Margin="0,16,0,0"
                                 Maximum="100" Style="{StaticResource DarkProgressBar}" />
                    <TextBlock x:Name="ProgressPercent" Margin="0,10,0,0" Foreground="#818CF8"
                               HorizontalAlignment="Right" Text="0%" />
                </StackPanel>

                <!-- 第 3 步：完成 -->
                <StackPanel x:Name="DonePage" Margin="32,44,32,24" Visibility="Collapsed">
                    <Border Width="64" Height="64" CornerRadius="32" Background="#113328"
                            HorizontalAlignment="Left">
                        <TextBlock Text="✓" Foreground="#10B981" FontSize="34" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="安装完成" FontSize="24" FontWeight="Bold" Margin="0,18,0,0" />
                    <TextBlock Text="符号工具已安装到：" Margin="0,12,0,0" Foreground="#A6ADC8" />
                    <TextBlock x:Name="DonePath" Foreground="#E4E4E7" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock x:Name="DoneAutoStart" Foreground="#A6ADC8" Margin="0,10,0,0" TextWrapping="Wrap" />

                    <Grid Margin="0,34,0,0">
                        <Button Content="打开安装目录" Width="132" Height="40" HorizontalAlignment="Left"
                                Style="{StaticResource SecondaryButton}" Click="OpenDir_Click" />
                        <Button Content="完成" Width="120" Height="40" HorizontalAlignment="Right"
                                Style="{StaticResource PrimaryButton}" Click="Finish_Click" />
                    </Grid>
                </StackPanel>

            </Grid>
        </Grid>
    </Border>
</Window>

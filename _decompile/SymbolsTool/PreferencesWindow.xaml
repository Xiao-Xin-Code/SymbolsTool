<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SymbolsTool.PreferencesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" WindowStyle="None" AllowsTransparency="True" Background="#00FFFFFF" ShowInTaskbar="False" ResizeMode="NoResize" Width="380" Height="212" WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI, Segoe UI" UseLayoutRounding="True" xmlns:symbolstool="clr-namespace:SymbolsTool;assembly=SymbolsTool">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="GhostButton" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="#FFA6ADC8" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" CornerRadius="8">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#1AFFFFFF" />
                  <Setter Property="Foreground" Value="#FFCDD6F4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Background" Value="#FF6366F1" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" CornerRadius="8">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#FF7C7FF5" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter Property="Background" Value="#FF4F46E5" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="HotkeyBox" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="#FFCDD6F4" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextBoxBase.IsReadOnly" Value="True" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="TextBoxBase.CaretBrush" Value="#00FFFFFF" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Background="#FF1E1E2E" CornerRadius="14" BorderBrush="#FF45475A" BorderThickness="1" Padding="16">
    <UIElement.Effect>
      <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.35" Color="#FF000000" />
    </UIElement.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Row="0" Background="#00FFFFFF" MouseLeftButtonDown="OnHeaderDrag">
        <TextBlock Text="首选项" FontSize="13" FontWeight="SemiBold" Foreground="#FFCDD6F4" VerticalAlignment="Center" />
        <Button Width="24" Height="24" HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Padding="0" ToolTip="关闭" Click="OnClose">
          <Path Data="M18,6 L6,18 M6,6 L18,18" Stroke="#FFA6ADC8" StrokeThickness="1" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" />
        </Button>
      </Grid>
      <Grid Row="1" Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="显示/隐藏符号面板" FontSize="12" Foreground="#FFCDD6F4" VerticalAlignment="Center" />
        <Border Grid.Row="0" Grid.Column="1" Width="150" Height="30" Background="#FF313244" BorderBrush="#FF45475A" BorderThickness="1" CornerRadius="10">
          <TextBox Name="PanelHotkeyBox" Style="{StaticResource HotkeyBox}" PreviewKeyDown="OnHotkeyKeyDown" />
        </Border>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Text="点击输入框后按下组合键即可修改（需包含 Ctrl 或 Alt）" FontSize="11" Foreground="#FF6B6F8A" />
      </Grid>
      <Grid Row="2" Margin="0,14,0,0">
        <Button Content="恢复默认" HorizontalAlignment="Left" Style="{StaticResource GhostButton}" Click="OnResetDefaults" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="取消" Style="{StaticResource GhostButton}" Click="OnCancel" />
          <Button Content="保存" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Click="OnSave" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
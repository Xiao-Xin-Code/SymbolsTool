<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SymbolsTool.FloatingBallWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" WindowStyle="None" AllowsTransparency="True" Background="#00FFFFFF" ShowInTaskbar="False" Topmost="True" ShowActivated="False" ResizeMode="NoResize" ClipToBounds="False" Width="84" Height="84" MinWidth="84" MaxWidth="84" MinHeight="84" MaxHeight="84" xmlns:symbolstool="clr-namespace:SymbolsTool;assembly=SymbolsTool" MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave" MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseUp" Loaded="OnLoaded">
  <Grid Cursor="Hand">
    <Ellipse Name="Ball" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
      <Shape.Fill>
        <RadialGradientBrush x:Name="BallBrush" GradientOrigin="0.3,0.3" Center="0.5,0.5" RadiusX="0.6" RadiusY="0.6">
          <GradientStop Color="#FF818CF8" Offset="0.0" />
          <GradientStop Color="#FF6366F1" Offset="0.6" />
          <GradientStop Color="#FF4F46E5" Offset="1.0" />
        </RadialGradientBrush>
      </Shape.Fill>
      <UIElement.Effect>
        <DropShadowEffect x:Name="BallShadow" BlurRadius="8" ShadowDepth="0" Opacity="0.50" Color="#FF6366F1" />
      </UIElement.Effect>
      <UIElement.RenderTransform>
        <ScaleTransform x:Name="BallScale" ScaleX="1.0" ScaleY="1.0" />
      </UIElement.RenderTransform>
    </Ellipse>
  </Grid>
</Window>
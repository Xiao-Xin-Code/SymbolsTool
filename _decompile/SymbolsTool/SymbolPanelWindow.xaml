<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="SymbolsTool.SymbolPanelWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SymbolsTool" WindowStyle="None" AllowsTransparency="True" Background="#00FFFFFF" ShowInTaskbar="False" Topmost="False" ResizeMode="NoResize" Width="320" Height="258" WindowStartupLocation="Manual" KeyDown="OnKeyDown">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="CategoryTabStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="#FFA6ADC8" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Height" Value="28" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" CornerRadius="14">
                <ContentPresenter Margin="{TemplateBinding Control.Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="Foreground" Value="#FFCDD6F4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="CategoryTabActiveStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource CategoryTabStyle}">
        <Setter Property="Background" Value="#FF6366F1" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
      </Style>
      <Style x:Key="CategoryTabDimmedStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource CategoryTabStyle}">
        <Setter Property="Foreground" Value="#FF5A5B74" />
        <Setter Property="FrameworkElement.Cursor" Value="Arrow" />
      </Style>
      <Style x:Key="SymbolBtnStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="#FFCDD6F4" />
        <Setter Property="BorderThickness" Value="0" />
        <!-- 不接受键盘焦点：WPF 按下按钮时会 Focus()，给非活动窗口里的控件设焦点
             会把面板激活，从而让目标程序失活、输入必须走回退路径并造成闪烁 -->
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="40" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontFamily" Value="Segoe UI Emoji, Segoe UI, Microsoft YaHei UI" />
        <Setter Property="ToolTipService.IsEnabled" Value="{Binding ShowSymbolNames, RelativeSource={RelativeSource AncestorType=Window}}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="SymBd" Background="{TemplateBinding Control.Background}" CornerRadius="6" BorderThickness="0" BorderBrush="#FF6366F1">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="SymBd" Property="Border.BorderThickness" Value="1" />
                  <Setter Property="Background" Value="#146366F1" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter Property="Background" Value="#226366F1" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="HeaderBtnStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="HBd" Background="{TemplateBinding Control.Background}" CornerRadius="6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#1AFFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="SymbolContextMenuStyle" TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="#FF1E1E2E" />
        <Setter Property="BorderBrush" Value="#FF45475A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ContextMenu}">
              <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Control.Padding}">
                <UIElement.Effect>
                  <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35" Color="#FF000000" />
                </UIElement.Effect>
                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="SymbolMenuItemStyle" TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="#FFCDD6F4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type MenuItem}">
              <Border Name="MBd" Background="#00FFFFFF" CornerRadius="5" Padding="{TemplateBinding Control.Padding}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Path Name="MIcon" Data="M9,9 L19,9 L19,19 L9,19 M15,9 L15,5 L5,5 L5,15 L9,15" Stroke="#FFA6ADC8" StrokeThickness="1.1" Stretch="Uniform" Width="10" Height="10" Margin="0,0,5,0" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                  <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="MenuItem.IsHighlighted" Value="True">
                  <Setter TargetName="MBd" Property="Border.Background" Value="#FF313244" />
                  <Setter TargetName="MIcon" Property="Shape.Stroke" Value="#FFCDD6F4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <ContextMenu x:Key="SymbolCopyMenu" Placement="Bottom" VerticalOffset="2" HorizontalOffset="-6" Style="{StaticResource SymbolContextMenuStyle}" Opened="SymbolMenu_Opened" Closed="SymbolMenu_Closed">
        <MenuItem Header="复制" Style="{StaticResource SymbolMenuItemStyle}" Click="CopySymbol_Click" />
      </ContextMenu>
      <DataTemplate x:Key="SymbolPlainTemplate">
        <Button Style="{StaticResource SymbolBtnStyle}" ToolTip="{Binding ToolTipText}" Click="Symbol_Click" PreviewMouseRightButtonUp="Symbol_RightMouseUp">
          <TextBlock Text="{Binding Char}" />
        </Button>
      </DataTemplate>
      <DataTemplate x:Key="SymbolColorTemplate">
        <Button Style="{StaticResource SymbolBtnStyle}" ToolTip="{Binding ToolTipText}" Click="Symbol_Click" PreviewMouseRightButtonUp="Symbol_RightMouseUp">
          <Image Width="22" Height="22" Stretch="Uniform" Source="{Binding ColorImage}" />
        </Button>
      </DataTemplate>
      <local:SymbolTemplateSelector x:Key="SymbolItemTemplateSelector" PlainTemplate="{StaticResource SymbolPlainTemplate}" ColorTemplate="{StaticResource SymbolColorTemplate}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Canvas Width="320" Height="258">
    <Border Name="PanelBorder" Canvas.Left="0" Canvas.Top="0" Width="320" Height="258" Background="#FF1E1E2E" CornerRadius="14" Padding="12" BorderBrush="#FF45475A" BorderThickness="1" MouseLeftButtonDown="OnPanelMouseDown" MouseMove="OnPanelMouseMove" MouseLeftButtonUp="OnPanelMouseUp">
      <UIElement.Effect>
        <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.35" Color="#FF000000" />
      </UIElement.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="136" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Row="0" Margin="4,0,4,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
            <Path Data="M12,3 L10.088000000000001,8.812999999999999 A2,2 0 0 1 8.813,10.088L3,12 L8.812999999999999,13.911999999999999 A2,2 0 0 1 10.088,15.187L12,21 L13.911999999999999,15.187000000000001 A2,2 0 0 1 15.187,13.912L21,12 L15.187000000000001,10.088000000000001 A2,2 0 0 1 13.912,8.813L12,3 M5,3 L5,7 M19,17 L19,21 M3,5 L7,5 M17,19 L21,19" Stroke="#FFCDD6F4" StrokeThickness="1.2" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock Text="符号工具" FontSize="12" FontWeight="SemiBold" Foreground="#FFCDD6F4" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Grid.Column="2">
            <Button ToolTip="置顶" Style="{StaticResource HeaderBtnStyle}" Click="OnPinClick">
              <Path Name="PinIcon" Data="M12,17 L12,22 M9,10.76 A2,2 0 0 1 7.89,12.55L6.109999999999999,13.450000000000001 A2,2 0 0 0 5,15.24L5,16 A1,1 0 0 0 6,17L18,17 A1,1 0 0 0 19,16L19,15.24 A2,2 0 0 0 17.89,13.45L16.11,12.549999999999999 A2,2 0 0 1 15,10.76L15,7 A1,1 0 0 1 16,6A2,2 0 0 0 16,2L8,2 A2,2 0 0 0 8,6A1,1 0 0 1 9,7" Stroke="#FFA6ADC8" StrokeThickness="1" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="12" Height="12" />
            </Button>
            <Button ToolTip="关闭" Style="{StaticResource HeaderBtnStyle}" Click="OnCloseClick">
              <Path Data="M18,6 L6,18 M6,6 L18,18" Stroke="#FFA6ADC8" StrokeThickness="1" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" />
            </Button>
          </StackPanel>
        </Grid>
        <ScrollViewer Name="CategoryScroll" Grid.Row="1" Margin="0,0,0,8" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
          <ItemsControl Name="CategoryTabs">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Margin="0,0,4,0" Style="{StaticResource CategoryTabStyle}" Content="{Binding}" Click="CategoryTab_Click" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <ScrollViewer Name="SymbolScroll" Grid.Row="2" Margin="0,4,0,8" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" ScrollChanged="SymbolScroll_ScrollChanged">
          <ItemsControl Name="SymbolGrid" ClipToBounds="True" ItemTemplateSelector="{StaticResource SymbolItemTemplateSelector}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" ItemWidth="49" ItemHeight="42" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>
        <Border Name="SearchBorder" Grid.Row="3" Background="#FF313244" BorderBrush="#FF45475A" BorderThickness="1" CornerRadius="10" Height="28">
          <Grid Margin="8,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Path Grid.Column="0" Data="M19,11 A8,8 0 1 1 3,11A8,8 0 0 1 19,11M21,21 L16.7,16.7" Stroke="#FFA6ADC8" StrokeThickness="1" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center" />
            <Grid Column="1">
              <TextBlock Name="SearchPlaceholder" Text="搜索符号、中文名或英文名..." FontSize="12" Foreground="#FF6B6F8A" VerticalAlignment="Center" IsHitTestVisible="False" />
              <TextBox Name="SearchBox" Background="#00FFFFFF" Foreground="#FFCDD6F4" BorderThickness="0" FontSize="12" VerticalContentAlignment="Center" CaretBrush="#FFCDD6F4" PreviewMouseLeftButtonDown="SearchBox_PreviewMouseDown" TextChanged="SearchBox_TextChanged" />
            </Grid>
            <Border Name="ClearBtn" Grid.Column="2" Width="18" Height="18" Background="#FF6366F1" CornerRadius="4" Cursor="Hand" Visibility="Collapsed" MouseLeftButtonDown="ClearBtn_Click">
              <Path Data="M18,6 L6,18 M6,6 L18,18" Stroke="#FFFFFFFF" StrokeThickness="1.3" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Canvas>
</Window>